# Trained model artifacts (not committed; rebuild via the train_* commands).
# The .gitkeep files keep empty directories tracked so a fresh clone has
# the right folder layout for joblib to write into.
models/**/*.pkl
models/**/*.joblib
models/**/*.json
!models/.gitkeep
!models/**/.gitkeep

alerts-debug.json

# FHH AI Optimizer — environment template
#
# Copy this file to `.env` (which is gitignored) and fill in the values.
# Never commit `.env` to source control.

# ---------------------------------------------------------------------------
# TimescaleDB / PostgreSQL connection used by both the API and the seeders.
# Format accepts the bare scheme (asyncpg) or `postgresql+psycopg2://`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/fhh_optimizers

# ---------------------------------------------------------------------------
# Anthropic API — used by POST /chat. The key MUST stay server-side.
# Get one from https://console.anthropic.com/. Without this set the
# /chat endpoint returns HTTP 502 (chat_unavailable) and the rest of the
# app keeps working unchanged.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Admin token gating /admin/retrain and /admin/retrain-demand.
# Defaults to "fhh-admin-dev-token" if unset.
# ---------------------------------------------------------------------------
# ADMIN_TOKEN=
